  "query": "\n        SELECT s.id, s.project_id, s.name, s.sort_order\n        FROM section s\n        JOIN project p ON p.id = s.project_id\n        WHERE s.project_id = $1 AND p.account_id = $2\n        ORDER BY s.sort_order, s.created_at\n        ",
