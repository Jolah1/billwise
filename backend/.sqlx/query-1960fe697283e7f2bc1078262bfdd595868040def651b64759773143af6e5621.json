{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id,\n               i.section_id,\n               i.description,\n               i.quantity,\n               i.unit,\n               i.rate_kobo,\n               i.item_type::text AS \"item_type!: String\",\n               i.sort_order\n        FROM item i\n        JOIN section s ON s.id = i.section_id\n        JOIN project p ON p.id = s.project_id\n        WHERE p.id = $1 AND p.account_id = $2\n        ORDER BY s.sort_order, i.sort_order\n        ",
