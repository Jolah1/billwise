{
  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO section (project_id, name, sort_order)\n        SELECT p.id,\n               $2,\n               COALESCE((SELECT MAX(sort_order) + 1 FROM section WHERE project_id = p.id), 0)\n        FROM project p\n        WHERE p.id = $1 AND p.account_id = $3\n        RETURNING id, project_id, name, sort_order\n        ",
