# Copy to backend/.env and edit values as needed.

# Postgres connection — matches the credentials baked into docker-compose.yml.
DATABASE_URL=postgres://billwise:billwise@localhost:5432/billwise

# Where the axum server binds.
BIND_ADDR=0.0.0.0:3000

# JWT signing. ROTATE THIS for anything other than local dev — invalidates
# all outstanding tokens, which is what you want on compromise.
JWT_SECRET=dev-only-change-me-in-real-environments
JWT_TTL_SECONDS=86400

# Tracing filter. `billwise=debug` is the crate; `sqlx=warn` keeps the
# query-log noise down. Override via RUST_LOG if you need something else.
RUST_LOG=info,billwise=debug,tower_http=info,sqlx=warn
